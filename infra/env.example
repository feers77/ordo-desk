# Copiar a /etc/ordo-desk/env (modo 0600). Nunca al repositorio.
DESK_SESSION_SECRET=          # python -c "import secrets;print(secrets.token_hex(32))"
DESK_TENANT=ropa
ORDO_API_URL=http://127.0.0.1:8000
ORDO_IAM_URL=http://127.0.0.1:8002
OIDC_TOKEN_URL=http://127.0.0.1:8080/realms/ordo/protocol/openid-connect/token
OIDC_CLIENT_ID=ordo-cli

# 0 solo si se sirve por HTTP plano (LAN sin TLS): la cookie viaja en claro.
DESK_COOKIE_SECURE=1

# Una identidad por persona. Las emite `make provision TENANT=ropa`.
DESK_CAJERO_AGENT_ID=
DESK_CAJERO_AGENT_SECRET=
DESK_CAJERO_USER=
DESK_CAJERO_PASSWORD=
DESK_BODEGUERO_AGENT_ID=
DESK_BODEGUERO_AGENT_SECRET=
DESK_BODEGUERO_USER=
DESK_BODEGUERO_PASSWORD=
DESK_DUENA_AGENT_ID=
DESK_DUENA_AGENT_SECRET=
DESK_DUENA_USER=
DESK_DUENA_PASSWORD=
