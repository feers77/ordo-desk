[Unit]
Description=Escritorio de ORDO (interfaces humanas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=feres
WorkingDirectory=/home/feres/ordo-desk
EnvironmentFile=/etc/ordo-desk/env
Environment=PYTHONPATH=/home/feres/ordo-desk/bff/src
ExecStart=/home/feres/ordo-desk/.venv/bin/uvicorn ordo_desk.main:create_app --factory --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/feres/ordo-desk

[Install]
WantedBy=multi-user.target
